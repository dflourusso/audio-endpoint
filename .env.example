# Copiado para .env pelo install.sh. Este arquivo é versionado; .env não.
AUDIO_ENDPOINT_ROOT=/opt/audio-endpoint
BRIDGE_IMAGE=ghcr.io/trudenboy/sendspin-bt-bridge:2.75.0
AUDIO_UID=1000
AUDIO_GID=1000
TZ=America/Sao_Paulo
BRIDGE_URL=http://127.0.0.1:8080
# Preencha só se a autenticação do bridge estiver ligada.
BRIDGE_TOKEN=
# Vazio desliga a autenticação da nossa API. Um valor exige Authorization: Bearer.
API_TOKEN=
WEB_PORT=80
BRIDGE_WEB_PORT=8080
SENDSPIN_SERVER=auto
PROJECT_VERSION=0.2.3
SHAIRPORT_IMAGE=mikebrady/shairport-sync:5.5.2
# Não dispara mais. O webhook de cada caixa fica na página Bluetooth, gravado fora do Git.
AIRPLAY_WEBHOOK_URL=
